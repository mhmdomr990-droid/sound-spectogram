<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted only for LAN / private deployments (HTTP server).
     When HTTPS is available, switch base-config cleartextTrafficPermitted to false. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
